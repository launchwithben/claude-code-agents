#!/usr/bin/env bash
# kit-check - run every fixture the kit ships (hooks/*.test.sh, bin/*.test.sh) and fail if any of them does.
#   bash kit-check            from a clone of the kit: bash core/bin/kit-check (or the ./kit-check wrapper)
#   bash scripts/roles-kit/bin/kit-check    from a project that installed the kit: wire this into the project's gate
# Each fixture file must end with a line `ALL PASS`. A fixture that prints anything else, or exits non-zero, fails.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
core="$(cd "$here/.." && pwd)"
fail=0; n=0
for t in "$core"/hooks/*.test.sh "$core"/bin/*.test.sh; do
  [ -f "$t" ] || continue
  n=$((n+1))
  out="$(bash "$t" 2>&1)"; rc=$?
  last="$(printf '%s\n' "$out" | tail -1)"
  if [ "$rc" = 0 ] && [ "$last" = "ALL PASS" ]; then
    printf 'PASS  %s\n' "$(basename "$t")"
  else
    printf 'FAIL  %s (exit %s)\n' "$(basename "$t")" "$rc"; printf '%s\n' "$out" | grep -E 'FAIL|usage|error' | head -8 | sed 's/^/        /'
    fail=1
  fi
done
[ "$n" -gt 0 ] || { echo "kit-check: no fixtures found under $core"; exit 1; }
[ "$fail" = 0 ] && echo "kit-check: ALL $n FIXTURE FILES PASS" || echo "kit-check: FAILED"
exit $fail
